# Pooler (transaction mode) — usado pela API em runtime
DATABASE_URL="postgresql://app_tenant.<project-ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"
# Conexão direta — usada pela CLI do Prisma (migrations)
DIRECT_URL="postgresql://postgres:<senha>@db.<project-ref>.supabase.co:5432/postgres"

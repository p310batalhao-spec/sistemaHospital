// =============================================================================
// Módulo 8 — Motor Financeiro
//  B2C: faturas, cobranças (Pix/Boleto/Cartão via gateway), régua, renegociação
//  B2B: transações de benefício (rastreio do desconto), repasses, comissões
//  DRE: lançamentos financeiros por competência
// Registros financeiros nunca são apagados (trigger); correções via estorno.
// =============================================================================

enum StatusFatura {
  ABERTA
  PAGA
  VENCIDA
  CANCELADA
  RENEGOCIADA
  ESTORNADA
}

enum TipoFatura {
  MENSALIDADE
  ADESAO
  DEPENDENTE_ADICIONAL
  RENEGOCIACAO
  AVULSA
}

model Fatura {
  id                 String           @id @default(uuid(7)) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  assinaturaId       String           @map("assinatura_id") @db.Uuid
  numero             String
  tipo               TipoFatura
  /// Primeiro dia do mês de referência (mensalidades).
  competencia        DateTime?        @db.Date
  vencimento         DateTime         @db.Date
  valorOriginal      Decimal          @map("valor_original") @db.Decimal(12, 2)
  valorDesconto      Decimal          @default(0) @map("valor_desconto") @db.Decimal(12, 2)
  valorJuros         Decimal          @default(0) @map("valor_juros") @db.Decimal(12, 2)
  valorMulta         Decimal          @default(0) @map("valor_multa") @db.Decimal(12, 2)
  valorTotal         Decimal          @map("valor_total") @db.Decimal(12, 2)
  valorPago          Decimal?         @map("valor_pago") @db.Decimal(12, 2)
  status             StatusFatura     @default(ABERTA)
  metodoPagamento    MetodoPagamento? @map("metodo_pagamento")
  pagaEm             DateTime?        @map("paga_em") @db.Timestamptz(6)
  /// Preenchido nas faturas geradas por um acordo.
  renegociacaoId     String?          @map("renegociacao_id") @db.Uuid
  parcela            Int?             @db.SmallInt
  canceladaEm        DateTime?        @map("cancelada_em") @db.Timestamptz(6)
  motivoCancelamento String?          @map("motivo_cancelamento")
  criadoEm           DateTime         @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm       DateTime         @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  assinatura   Assinatura    @relation(fields: [assinaturaId], references: [id])
  renegociacao Renegociacao? @relation("FaturasGeradas", fields: [renegociacaoId], references: [id])

  cobrancas            Cobranca[]
  renegociadaEm        RenegociacaoFatura[]
  notificacoes         Notificacao[]
  lancamentos          LancamentoFinanceiro[]

  @@unique([tenantId, numero])
  /// Idempotência do job mensal: uma mensalidade por competência.
  @@unique([assinaturaId, tipo, competencia])
  @@index([tenantId, status, vencimento])
  @@map("faturas")
}

enum StatusCobranca {
  PENDENTE
  CONFIRMADA
  RECEBIDA
  VENCIDA
  CANCELADA
  ESTORNADA
  FALHOU
}

/// Tentativa de cobrança no gateway (uma fatura pode ter várias: 2ª via, troca de método).
model Cobranca {
  id                   String           @id @default(uuid(7)) @db.Uuid
  tenantId             String           @map("tenant_id") @db.Uuid
  faturaId             String           @map("fatura_id") @db.Uuid
  gateway              GatewayPagamento
  metodo               MetodoPagamento
  gatewayCobrancaId    String           @map("gateway_cobranca_id")
  status               StatusCobranca   @default(PENDENTE)
  valor                Decimal          @db.Decimal(12, 2)
  pixTxid              String?          @map("pix_txid")
  pixCopiaECola        String?          @map("pix_copia_e_cola")
  pixExpiraEm          DateTime?        @map("pix_expira_em") @db.Timestamptz(6)
  boletoLinhaDigitavel String?          @map("boleto_linha_digitavel")
  boletoCodigoBarras   String?          @map("boleto_codigo_barras")
  boletoUrl            String?          @map("boleto_url")
  linkPagamento        String?          @map("link_pagamento")
  cartaoFinal          String?          @map("cartao_final") @db.Char(4)
  taxaGateway          Decimal?         @map("taxa_gateway") @db.Decimal(12, 2)
  valorLiquido         Decimal?         @map("valor_liquido") @db.Decimal(12, 2)
  pagaEm               DateTime?        @map("paga_em") @db.Timestamptz(6)
  criadoEm             DateTime         @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm         DateTime         @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  tenant      Tenant                 @relation(fields: [tenantId], references: [id])
  fatura      Fatura                 @relation(fields: [faturaId], references: [id])
  lancamentos LancamentoFinanceiro[]

  @@unique([gateway, gatewayCobrancaId])
  @@index([faturaId])
  @@map("cobrancas")
}

enum OrigemWebhook {
  ASAAS
  MERCADO_PAGO
  STRIPE
  META_WHATSAPP
}

enum StatusWebhook {
  RECEBIDO
  PROCESSADO
  IGNORADO
  ERRO
}

/// Inbox idempotente de webhooks. tenant_id é resolvido após o parse (por isso opcional);
/// processado apenas pelo worker com papel de plataforma.
model WebhookEvento {
  id              String        @id @default(uuid(7)) @db.Uuid
  tenantId        String?       @map("tenant_id") @db.Uuid
  origem          OrigemWebhook
  eventoIdExterno String        @map("evento_id_externo")
  tipoEvento      String        @map("tipo_evento")
  payload         Json
  assinaturaValida Boolean      @map("assinatura_valida")
  status          StatusWebhook @default(RECEBIDO)
  tentativas      Int           @default(0) @db.SmallInt
  erro            String?
  recebidoEm      DateTime      @default(now()) @map("recebido_em") @db.Timestamptz(6)
  processadoEm    DateTime?     @map("processado_em") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([origem, eventoIdExterno])
  @@index([status, recebidoEm])
  @@map("webhook_eventos")
}

enum AcaoRegua {
  NOTIFICAR
  GERAR_SEGUNDA_VIA
  SUSPENDER_BENEFICIOS
  CANCELAR_ASSINATURA
}

model ReguaCobranca {
  id       String   @id @default(uuid(7)) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  nome     String
  padrao   Boolean  @default(false)
  ativa    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  etapas      ReguaEtapa[]
  assinaturas Assinatura[]

  @@map("reguas_cobranca")
}

/// Ex.: D-3 WhatsApp lembrete · D0 Pix do dia · D+3 2ª via · D+15 suspender · D+60 cancelar.
model ReguaEtapa {
  id                     String            @id @default(uuid(7)) @db.Uuid
  tenantId               String            @map("tenant_id") @db.Uuid
  reguaId                String            @map("regua_id") @db.Uuid
  diasRelativoVencimento Int               @map("dias_relativo_vencimento") @db.SmallInt
  acao                   AcaoRegua
  canal                  CanalComunicacao?
  templateId             String?           @map("template_id") @db.Uuid
  horarioEnvio           DateTime?         @map("horario_envio") @db.Time(0)
  ordem                  Int               @db.SmallInt

  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  regua        ReguaCobranca     @relation(fields: [reguaId], references: [id], onDelete: Cascade)
  template     TemplateMensagem? @relation(fields: [templateId], references: [id])
  notificacoes Notificacao[]

  @@index([reguaId, diasRelativoVencimento])
  @@map("regua_etapas")
}

enum StatusRenegociacao {
  PROPOSTA
  ACEITA
  CUMPRIDA
  QUEBRADA
  CANCELADA
}

model Renegociacao {
  id                String             @id @default(uuid(7)) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  assinaturaId      String             @map("assinatura_id") @db.Uuid
  status            StatusRenegociacao @default(PROPOSTA)
  valorDivida       Decimal            @map("valor_divida") @db.Decimal(12, 2)
  valorDesconto     Decimal            @default(0) @map("valor_desconto") @db.Decimal(12, 2)
  valorNegociado    Decimal            @map("valor_negociado") @db.Decimal(12, 2)
  parcelas          Int                @db.SmallInt
  aceitaEm          DateTime?          @map("aceita_em") @db.Timestamptz(6)
  criadoPorMembroId String?            @map("criado_por_membro_id") @db.Uuid
  criadoEm          DateTime           @default(now()) @map("criado_em") @db.Timestamptz(6)

  tenant           Tenant               @relation(fields: [tenantId], references: [id])
  assinatura       Assinatura           @relation(fields: [assinaturaId], references: [id])
  faturasOriginais RenegociacaoFatura[]
  faturasGeradas   Fatura[]             @relation("FaturasGeradas")

  @@map("renegociacoes")
}

model RenegociacaoFatura {
  tenantId       String @map("tenant_id") @db.Uuid
  renegociacaoId String @map("renegociacao_id") @db.Uuid
  faturaId       String @map("fatura_id") @db.Uuid

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  renegociacao Renegociacao @relation(fields: [renegociacaoId], references: [id])
  fatura       Fatura       @relation(fields: [faturaId], references: [id])

  @@id([renegociacaoId, faturaId])
  @@map("renegociacao_faturas")
}

// -----------------------------------------------------------------------------
// B2B — rastreio de descontos concedidos e repasses
// -----------------------------------------------------------------------------

enum OrigemTransacao {
  AGENDAMENTO
  ATENDIMENTO
  BALCAO_FARMACIA
  ODONTOLOGIA
  PORTAL_PARCEIRO
  API_PARCEIRO
}

enum StatusTransacao {
  AUTORIZADA
  CONFIRMADA
  ESTORNADA
  CONTESTADA
}

/// Registro imutável de cada uso de benefício: QUEM (parceiro/profissional) concedeu
/// QUANTO de desconto, PARA QUEM, sobre QUAL item, com QUAL regra — base da conciliação B2B.
model TransacaoBeneficio {
  id                       String           @id @default(uuid(7)) @db.Uuid
  tenantId                 String           @map("tenant_id") @db.Uuid
  codigoAutorizacao        String           @map("codigo_autorizacao")
  /// Enviada pelo cliente (PDV da farmácia/portal) para evitar lançamento duplicado.
  chaveIdempotencia        String           @map("chave_idempotencia")
  beneficiarioId           String           @map("beneficiario_id") @db.Uuid
  pessoaId                 String           @map("pessoa_id") @db.Uuid
  estabelecimentoId        String           @map("estabelecimento_id") @db.Uuid
  profissionalId           String?          @map("profissional_id") @db.Uuid
  itemCatalogoId           String?          @map("item_catalogo_id") @db.Uuid
  /// Snapshot do item (farmácias podem lançar produto fora do catálogo).
  descricaoItem            String           @map("descricao_item")
  categoria                CategoriaServico
  planoBeneficioId         String?          @map("plano_beneficio_id") @db.Uuid
  validacaoId              String?          @map("validacao_id") @db.Uuid
  atendimentoId            String?          @map("atendimento_id") @db.Uuid
  agendamentoId            String?          @map("agendamento_id") @db.Uuid
  origem                   OrigemTransacao
  status                   StatusTransacao  @default(AUTORIZADA)
  quantidade               Decimal          @default(1) @db.Decimal(10, 3)
  valorOriginal            Decimal          @map("valor_original") @db.Decimal(12, 2)
  valorDesconto            Decimal          @map("valor_desconto") @db.Decimal(12, 2)
  valorPagoBeneficiario    Decimal          @map("valor_pago_beneficiario") @db.Decimal(12, 2)
  valorCoparticipacao      Decimal          @default(0) @map("valor_coparticipacao") @db.Decimal(12, 2)
  /// Matriz → parceiro (serviços INCLUSOS executados pela rede credenciada).
  valorRepasseParceiro     Decimal          @default(0) @map("valor_repasse_parceiro") @db.Decimal(12, 2)
  /// Parceiro → matriz (taxa de intermediação sobre vendas geradas pelo clube).
  valorTaxaMatriz          Decimal          @default(0) @map("valor_taxa_matriz") @db.Decimal(12, 2)
  /// Matriz → profissional (rede própria).
  valorComissaoProfissional Decimal         @default(0) @map("valor_comissao_profissional") @db.Decimal(12, 2)
  /// Snapshot das regras de benefício e repasse aplicadas no momento da transação.
  regrasAplicadas          Json             @map("regras_aplicadas")
  autorizadaPorMembroId    String?          @map("autorizada_por_membro_id") @db.Uuid
  ocorridaEm               DateTime         @default(now()) @map("ocorrida_em") @db.Timestamptz(6)
  confirmadaEm             DateTime?        @map("confirmada_em") @db.Timestamptz(6)
  /// Estorno é uma nova transação com valores negativos apontando para a original.
  transacaoOriginalId      String?          @map("transacao_original_id") @db.Uuid
  motivoEstorno            String?          @map("motivo_estorno")
  loteRepasseId            String?          @map("lote_repasse_id") @db.Uuid
  criadoEm                 DateTime         @default(now()) @map("criado_em") @db.Timestamptz(6)

  tenant            Tenant                  @relation(fields: [tenantId], references: [id])
  beneficiario      Beneficiario            @relation(fields: [beneficiarioId], references: [id])
  pessoa            Pessoa                  @relation(fields: [pessoaId], references: [id])
  estabelecimento   Estabelecimento         @relation(fields: [estabelecimentoId], references: [id])
  profissional      Profissional?           @relation(fields: [profissionalId], references: [id])
  itemCatalogo      ItemCatalogo?           @relation(fields: [itemCatalogoId], references: [id])
  planoBeneficio    PlanoBeneficio?         @relation(fields: [planoBeneficioId], references: [id])
  validacao         ValidacaoElegibilidade? @relation(fields: [validacaoId], references: [id])
  atendimento       Atendimento?            @relation(fields: [atendimentoId], references: [id])
  agendamento       Agendamento?            @relation(fields: [agendamentoId], references: [id])
  autorizadaPor     Membro?                 @relation(fields: [autorizadaPorMembroId], references: [id])
  transacaoOriginal TransacaoBeneficio?     @relation("Estorno", fields: [transacaoOriginalId], references: [id])
  estornos          TransacaoBeneficio[]    @relation("Estorno")
  loteRepasse       LoteRepasse?            @relation(fields: [loteRepasseId], references: [id])

  procedimentoOdonto ProcedimentoOdonto?
  avaliacao          Avaliacao?

  @@unique([tenantId, codigoAutorizacao])
  @@unique([tenantId, chaveIdempotencia])
  @@index([tenantId, estabelecimentoId, ocorridaEm])
  @@index([tenantId, beneficiarioId, ocorridaEm])
  @@index([tenantId, profissionalId, ocorridaEm])
  @@index([loteRepasseId])
  @@map("transacoes_beneficio")
}

enum TipoValor {
  PERCENTUAL
  VALOR_FIXO
}

enum SentidoRepasse {
  MATRIZ_PAGA_PARCEIRO
  PARCEIRO_PAGA_MATRIZ
  MATRIZ_PAGA_PROFISSIONAL
}

enum BaseCalculoRepasse {
  VALOR_ORIGINAL
  VALOR_PAGO
  VALOR_DESCONTO
}

/// Regras de repasse/comissão. A mais específica vence:
/// item > categoria; profissional > estabelecimento > tenant; depois `prioridade`.
model RegraRepasse {
  id                String             @id @default(uuid(7)) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  nome              String
  sentido           SentidoRepasse
  tipoValor         TipoValor          @map("tipo_valor")
  valor             Decimal            @db.Decimal(12, 4)
  baseCalculo       BaseCalculoRepasse @default(VALOR_PAGO) @map("base_calculo")
  estabelecimentoId String?            @map("estabelecimento_id") @db.Uuid
  profissionalId    String?            @map("profissional_id") @db.Uuid
  categoria         CategoriaServico?
  itemCatalogoId    String?            @map("item_catalogo_id") @db.Uuid
  prioridade        Int                @default(0) @db.SmallInt
  vigenciaInicio    DateTime           @map("vigencia_inicio") @db.Date
  vigenciaFim       DateTime?          @map("vigencia_fim") @db.Date
  ativa             Boolean            @default(true)
  criadoEm          DateTime           @default(now()) @map("criado_em") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  estabelecimento Estabelecimento? @relation(fields: [estabelecimentoId], references: [id])
  profissional    Profissional?    @relation(fields: [profissionalId], references: [id])
  itemCatalogo    ItemCatalogo?    @relation(fields: [itemCatalogoId], references: [id])

  @@index([tenantId, sentido, ativa])
  @@map("regras_repasse")
}

enum StatusLoteRepasse {
  ABERTO
  FECHADO
  EM_CONFERENCIA
  APROVADO
  PAGO
  CONTESTADO
}

/// Fechamento periódico (conciliação) por parceiro ou profissional.
model LoteRepasse {
  id                      String            @id @default(uuid(7)) @db.Uuid
  tenantId                String            @map("tenant_id") @db.Uuid
  estabelecimentoId       String?           @map("estabelecimento_id") @db.Uuid
  profissionalId          String?           @map("profissional_id") @db.Uuid
  periodoInicio           DateTime          @map("periodo_inicio") @db.Date
  periodoFim              DateTime          @map("periodo_fim") @db.Date
  quantidadeTransacoes    Int               @default(0) @map("quantidade_transacoes")
  valorTotalOriginal      Decimal           @default(0) @map("valor_total_original") @db.Decimal(14, 2)
  valorTotalDescontos     Decimal           @default(0) @map("valor_total_descontos") @db.Decimal(14, 2)
  valorRepasses           Decimal           @default(0) @map("valor_repasses") @db.Decimal(14, 2)
  valorTaxas              Decimal           @default(0) @map("valor_taxas") @db.Decimal(14, 2)
  /// Positivo: matriz paga. Negativo: parceiro deve à matriz.
  valorLiquido            Decimal           @default(0) @map("valor_liquido") @db.Decimal(14, 2)
  status                  StatusLoteRepasse @default(ABERTO)
  fechadoEm               DateTime?         @map("fechado_em") @db.Timestamptz(6)
  aprovadoPorMembroId     String?           @map("aprovado_por_membro_id") @db.Uuid
  aprovadoEm              DateTime?         @map("aprovado_em") @db.Timestamptz(6)
  pagoEm                  DateTime?         @map("pago_em") @db.Timestamptz(6)
  comprovanteDocumentoId  String?           @unique @map("comprovante_documento_id") @db.Uuid
  observacoes             String?
  criadoEm                DateTime          @default(now()) @map("criado_em") @db.Timestamptz(6)

  tenant          Tenant                 @relation(fields: [tenantId], references: [id])
  estabelecimento Estabelecimento?       @relation(fields: [estabelecimentoId], references: [id])
  profissional    Profissional?          @relation(fields: [profissionalId], references: [id])
  comprovante     Documento?             @relation(fields: [comprovanteDocumentoId], references: [id])
  transacoes      TransacaoBeneficio[]
  lancamentos     LancamentoFinanceiro[]

  @@index([tenantId, status, periodoFim])
  @@map("lotes_repasse")
}

enum TipoLancamento {
  RECEITA
  DESPESA
}

/// Plano de contas simplificado para a DRE gerencial.
enum ContaDre {
  RECEITA_MENSALIDADES
  RECEITA_ADESOES
  RECEITA_TAXAS_PARCEIROS
  RECEITA_SERVICOS_PROPRIOS
  DEDUCAO_ESTORNOS
  DEDUCAO_DESCONTOS_CONCEDIDOS
  CUSTO_REPASSES_PARCEIROS
  CUSTO_COMISSOES_PROFISSIONAIS
  DESPESA_TAXAS_GATEWAY
  DESPESA_COMUNICACAO
  DESPESA_PLATAFORMA_SAAS
  OUTRAS
}

model LancamentoFinanceiro {
  id                String          @id @default(uuid(7)) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  tipo              TipoLancamento
  conta             ContaDre
  descricao         String
  valor             Decimal         @db.Decimal(14, 2)
  /// Regime de competência (DRE) e de caixa (fluxo de caixa).
  competencia       DateTime        @db.Date
  dataCaixa         DateTime?       @map("data_caixa") @db.Date
  estabelecimentoId String?         @map("estabelecimento_id") @db.Uuid
  faturaId          String?         @map("fatura_id") @db.Uuid
  cobrancaId        String?         @map("cobranca_id") @db.Uuid
  loteRepasseId     String?         @map("lote_repasse_id") @db.Uuid
  criadoEm          DateTime        @default(now()) @map("criado_em") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  estabelecimento Estabelecimento? @relation(fields: [estabelecimentoId], references: [id])
  fatura          Fatura?          @relation(fields: [faturaId], references: [id])
  cobranca        Cobranca?        @relation(fields: [cobrancaId], references: [id])
  loteRepasse     LoteRepasse?     @relation(fields: [loteRepasseId], references: [id])

  @@index([tenantId, competencia, conta])
  @@map("lancamentos_financeiros")
}

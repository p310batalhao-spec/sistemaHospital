// =============================================================================
// Identidade, membros e RBAC
// Autenticação: Supabase Auth (auth.users). A API valida o JWT do Supabase e
// resolve tenant + papéis a partir destas tabelas.
// =============================================================================

enum PerfilPlataforma {
  MASTER_ADMIN
  MASTER_SUPORTE
  MASTER_FINANCEIRO
}

enum StatusMembro {
  PENDENTE_APROVACAO
  ATIVO
  BLOQUEADO
  REVOGADO
}

enum PlataformaDispositivo {
  ANDROID
  IOS
  WEB
}

/// Conta global de login. Uma pessoa pode ser membro de vários tenants (ex.: médico em dois hospitais).
model Usuario {
  id               String            @id @default(uuid(7)) @db.Uuid
  /// auth.users.id do Supabase.
  authUserId       String            @unique @map("auth_user_id") @db.Uuid
  email            String            @unique
  nome             String
  telefone         String?
  /// Preenchido apenas para a equipe da plataforma (Área Master).
  perfilPlataforma PerfilPlataforma? @map("perfil_plataforma")
  mfaObrigatorio   Boolean           @default(false) @map("mfa_obrigatorio")
  ativo            Boolean           @default(true)
  ultimoAcessoEm   DateTime?         @map("ultimo_acesso_em") @db.Timestamptz(6)
  criadoEm         DateTime          @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm     DateTime          @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  membros      Membro[]      @relation("MembroUsuario")
  aprovacoes   Membro[]      @relation("MembroAprovador")
  dispositivos Dispositivo[]
  conversasIa  ConversaIa[]
  notificacoes Notificacao[]

  @@map("usuarios")
}

/// Vínculo usuário ↔ tenant. Começa PENDENTE_APROVACAO (fluxo de aprovação do protótipo).
model Membro {
  id             String       @id @default(uuid(7)) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  usuarioId      String       @map("usuario_id") @db.Uuid
  status         StatusMembro @default(PENDENTE_APROVACAO)
  /// Preenchido quando o membro é um profissional de saúde.
  profissionalId String?      @unique @map("profissional_id") @db.Uuid
  /// Preenchido quando o membro é associado (acesso ao app do cliente).
  pessoaId       String?      @unique @map("pessoa_id") @db.Uuid
  aprovadoPorId  String?      @map("aprovado_por_id") @db.Uuid
  aprovadoEm     DateTime?    @map("aprovado_em") @db.Timestamptz(6)
  criadoEm       DateTime     @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm   DateTime     @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  usuario      Usuario       @relation("MembroUsuario", fields: [usuarioId], references: [id])
  aprovadoPor  Usuario?      @relation("MembroAprovador", fields: [aprovadoPorId], references: [id])
  profissional Profissional? @relation(fields: [profissionalId], references: [id])
  pessoa       Pessoa?       @relation(fields: [pessoaId], references: [id])
  papeis       MembroPapel[]

  validacoesRealizadas  ValidacaoElegibilidade[]
  transacoesAutorizadas TransacaoBeneficio[]

  @@unique([tenantId, usuarioId])
  @@map("membros")
}

/// Papel por tenant. Papéis de sistema (ADMIN_HOSPITAL, FINANCEIRO, RECEPCAO, MEDICO, DENTISTA,
/// PARCEIRO_GESTOR, FARMACIA_BALCAO, ASSOCIADO, AUDITOR) são clonados no onboarding.
model Papel {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  codigo    String
  nome      String
  descricao String?
  /// Papéis de sistema não podem ser editados/excluídos pelo tenant.
  sistema   Boolean  @default(false)
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissoes  PapelPermissao[]
  atribuicoes MembroPapel[]

  @@unique([tenantId, codigo])
  @@map("papeis")
}

/// Permissões no formato "recurso.acao" (ex.: "planos.gerenciar", "pep.ler", "financeiro.estornar").
/// O catálogo de permissões válidas vive no código (packages/shared).
model PapelPermissao {
  tenantId  String @map("tenant_id") @db.Uuid
  papelId   String @map("papel_id") @db.Uuid
  permissao String

  tenant Tenant @relation(fields: [tenantId], references: [id])
  papel  Papel  @relation(fields: [papelId], references: [id], onDelete: Cascade)

  @@id([papelId, permissao])
  @@map("papel_permissoes")
}

/// Atribuição de papel, opcionalmente restrita a um estabelecimento (ex.: balconista de UMA farmácia).
model MembroPapel {
  id                String   @id @default(uuid(7)) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  membroId          String   @map("membro_id") @db.Uuid
  papelId           String   @map("papel_id") @db.Uuid
  estabelecimentoId String?  @map("estabelecimento_id") @db.Uuid
  criadoEm          DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  membro          Membro           @relation(fields: [membroId], references: [id], onDelete: Cascade)
  papel           Papel            @relation(fields: [papelId], references: [id])
  estabelecimento Estabelecimento? @relation(fields: [estabelecimentoId], references: [id])

  @@index([membroId])
  @@map("membro_papeis")
}

/// Tokens FCM. Por tenant porque cada white label pode ter seu próprio projeto Firebase.
model Dispositivo {
  id          String                @id @default(uuid(7)) @db.Uuid
  tenantId    String                @map("tenant_id") @db.Uuid
  usuarioId   String                @map("usuario_id") @db.Uuid
  tokenFcm    String                @unique @map("token_fcm")
  plataforma  PlataformaDispositivo
  appVersao   String?               @map("app_versao")
  ultimoUsoEm DateTime              @default(now()) @map("ultimo_uso_em") @db.Timestamptz(6)
  criadoEm    DateTime              @default(now()) @map("criado_em") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("dispositivos")
}

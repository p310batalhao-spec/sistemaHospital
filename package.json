{
  "name": "elo-saude",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @elo-saude/database generate",
    "db:migrate": "pnpm --filter @elo-saude/database migrate:dev",
    "db:validate": "pnpm --filter @elo-saude/database validate"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
